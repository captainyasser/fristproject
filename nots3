INSERT INTO em.emdata_attendance (name, date, state, food, in_or_out, employee_id)
SELECT 
    emp.name, 
    att.date, 
    att.state, 
    att.food, 
    att.in_or_out, 
    att.employee_id
FROM yasser.attendance_attendance att
JOIN em.employees emp ON att.employee_id = emp.id
ON DUPLICATE KEY UPDATE 
    state = VALUES(state),
    food = VALUES(food),

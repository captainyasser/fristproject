UPDATE yasser.employees AS y
JOIN em.employees AS e ON y.id = e.id
JOIN yasser.departments AS d ON e.departments = d.name
SET y.department_id = d.id
WHERE e.departments IN (
    'شئون الأفراد',
    'شئون الدارسين',
    'شئون المجندين',

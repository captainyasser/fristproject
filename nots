INSERT INTO yasser.attendance_attendance (date, state, food, comfort_adjustment,created_at, updated_at, employee_id, in_or_out)
SELECT 
    date, 
    state, 
    food, 
    CASE 
        WHEN state = 'نوبتجي' THEN 1
        WHEN state IN ('راحة', 'ر بديلة', '8 صباحاً') THEN -1
        ELSE 0
    END AS comfort_adjustment,
    NOW() AS created_at, 
    NOW() AS updated_at,
    employee_id, 
    in_or_out
FROM em.emdata_attendance;




نقل عكسي للتشغيل

INSERT INTO em.emdata_attendance (name, date, state, food, in_or_out, employee_id)
SELECT 
    emp.name, 
    att.date, 
    att.state, 
    att.food, 
    att.in_or_out, 
    att.employee_id
FROM yasser.attendance_attendance att
JOIN em.employees emp ON att.employee_id = emp.id
ON DUPLICATE KEY UPDATE 
    state = VALUES(state),
    food = VALUES(food),
    in_or_out = VALUES(in_or_out);





